# Copie ce fichier en ".env" et remplis les valeurs avant de lancer le site.

# Clé secrète utilisée pour signer les cookies de session.
# Mets une longue chaîne aléatoire (ex: 40+ caractères).
SESSION_SECRET=change-moi-en-une-chaine-aleatoire-longue

# Mot de passe pour accéder au tableau de bord admin (/admin.html).
ADMIN_PASSWORD=change-moi

# Port d'écoute du serveur (la plupart des hébergeurs le fournissent automatiquement).
PORT=3000
